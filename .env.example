# Local infrastructure only; never commit real credentials.
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/prospecting?schema=public
REDIS_URL=redis://localhost:6379
# Generate unique production values in a secret manager.
SESSION_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Keyed hashing for login throttling/idempotency (>=32 chars) and AES-256-GCM key for stored idempotent responses.
HMAC_SECRET=replace-with-at-least-32-random-characters
# Number of trusted reverse proxies in front of the API (0 = none; do not guess).
TRUST_PROXY=0

# Web (Next.js server only; never exposed to the browser)
API_URL=http://127.0.0.1:3001
# Session cookie is Secure + __Host- prefixed in production; set to "false" only for http:// testing of a production build.
# SESSION_COOKIE_SECURE=true

# Docker (profile "app"): password for the least-privilege DB login role created by the migrate step (>= 16 chars).
APP_DB_PASSWORD=replace-with-a-long-random-password

# AI provider "anthropic" (AI_PROVIDER=anthropic). Without a key the provider stays disabled (clean 503). Never commit a real key.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Public URL of the web app: used in unsubscribe links inside real emails. Must be the real https URL in production.
# PUBLIC_BASE_URL=https://app.example.com
# AI provider: "anthropic" (needs ANTHROPIC_API_KEY) or "mock" (offline tests). Empty = AI answers 503.
# AI_PROVIDER=anthropic
# Email: each organization saves its own SMTP account in the web app (Empresa > Correo saliente); no SMTP variable lives here.
# OpenStreetMap discovery works without a key; override the endpoints only for a private mirror.
# OSM_NOMINATIM_URL=
# OSM_OVERPASS_URL=
