# Produccion: SOLO placeholders. Los valores reales viven en el gestor de secretos (BLOCKED: eleccion de nube/gestor).
NODE_ENV=production
DATABASE_URL=postgresql://app_login:<APP_DB_PASSWORD>@<DB_HOST>:5432/prospecting?schema=public
REDIS_URL=redis://<REDIS_HOST>:6379
HMAC_SECRET=<generar-32-bytes-aleatorios>
ENCRYPTION_KEY=<clave-32-bytes-base64; custodiar en KMS>
METRICS_TOKEN=<token-aleatorio>
TRUST_PROXY=1
REQUIRE_UNPRIVILEGED_DB_ROLE=1
SESSION_COOKIE_SECURE=true
API_URL=http://api:3001
