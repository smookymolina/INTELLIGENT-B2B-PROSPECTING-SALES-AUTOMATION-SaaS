generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  org_admin
  campaign_manager
  sales_manager
  seller
  analyst
  viewer

  @@map("membership_role")
}

enum RecordStatus {
  active
  disabled

  @@map("record_status")
}

/// Tenant root. RLS: id = app.organization_id.
model Organization {
  id         String       @id @default(uuid(7)) @db.Uuid
  name       String
  slug       String       @unique
  status     RecordStatus @default(active)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @updatedAt @db.Timestamptz(6)

  memberships Membership[]
  audit_events AuditEvent[]
  sessions    Session[]
  invitations Invitation[]
  profile     OrganizationProfile?
  branches    Branch[]
  catalog_categories CatalogCategory[]
  catalog_items      CatalogItem[]
  catalog_versions   CatalogItemVersion[]
  price_lists        PriceList[]
  price_entries      PriceListEntry[]
  import_jobs        ImportJob[]
  prospects          Prospect[]
  prospect_sources   ProspectSource[]
  suppressions       Suppression[]
  prospect_attributes ProspectAttribute[]
  scoring_versions   ScoringModelVersion[]
  score_results      ScoreResult[]
  lead_settings      LeadSettings?
  leads              Lead[]
  intent_assessments IntentAssessment[]
  routing_settings   RoutingSettings?
  seller_pool        SellerPoolMember[]
  opportunities      Opportunity[]
  opportunity_history OpportunityStageHistory[]
  opportunity_notes  OpportunityNote[]
  opportunity_tasks  OpportunityTask[]
  ai_budget          AiBudget?
  ai_runs            AiRun[]
  contacts           Contact[]
  consent_events     ConsentEvent[]
  campaigns          Campaign[]
  send_attempts      SendAttempt[]
  opportunity_assignments OpportunityAssignment[]
  quote_settings     QuoteSettings?
  quote_counter      QuoteCounter?
  quotes             Quote[]
  quote_lines        QuoteLine[]
  sales              Sale[]

  @@map("organizations")
}

/// Global identity (a person may belong to several organizations). Access is mediated by RLS + SECURITY DEFINER auth functions.
model User {
  id            String       @id @default(uuid(7)) @db.Uuid
  email         String       @unique
  password_hash String
  display_name  String
  status        RecordStatus @default(active)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Membership {
  id              String         @id @default(uuid(7)) @db.Uuid
  organization_id String         @db.Uuid
  user_id         String         @db.Uuid
  role            MembershipRole
  status          RecordStatus   @default(active)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, user_id])
  @@index([user_id])
  @@map("memberships")
}

/// Opaque bearer sessions; only the SHA-256 of the token is stored.
model Session {
  id              String    @id @default(uuid(7)) @db.Uuid
  organization_id String    @db.Uuid
  user_id         String    @db.Uuid
  token_hash      String    @unique
  expires_at      DateTime  @db.Timestamptz(6)
  revoked_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([organization_id, user_id])
  @@map("sessions")
}

/// Append-only (RLS has no UPDATE/DELETE policy; trigger blocks both).
model AuditEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  organization_id String   @db.Uuid
  actor_user_id   String?  @db.Uuid
  action          String
  resource_type   String
  resource_id     String?
  metadata        Json     @default("{}")
  request_id      String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@index([organization_id, created_at(sort: Desc)])
  @@map("audit_events")
}

/// Pre-tenant login throttle state. Only keyed HMACs, never raw IP/email. No grants to app_runtime: access via auth_login_* functions.
model LoginAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ip_hash      String
  account_hash String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([ip_hash, created_at])
  @@index([account_hash, created_at])
  @@index([created_at])
  @@map("login_attempts")
}

/// Idempotent command results. Keys are keyed HMACs; the stored response (may contain a session token) is AES-256-GCM ciphertext.
/// No grants to app_runtime: access via idem_* functions.
model IdempotencyKey {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope               String
  key_hash            String
  request_hash        String
  response_ciphertext String?
  completed_at        DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([scope, key_hash])
  @@index([created_at])
  @@map("idempotency_keys")
}

/// Pending membership offers. Creating one never creates a membership; acceptance (invitation_accept) does, atomically.
/// Only the SHA-256 of the token is stored. RLS: tenant-scoped, org_admin writes.
model Invitation {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String         @db.Uuid
  email           String
  role            MembershipRole
  token_hash      String         @unique
  invited_by      String         @db.Uuid
  expires_at      DateTime       @db.Timestamptz(6)
  accepted_at     DateTime?      @db.Timestamptz(6)
  accepted_by     String?        @db.Uuid
  revoked_at      DateTime?      @db.Timestamptz(6)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@index([organization_id, created_at(sort: Desc)])
  @@index([organization_id, email])
  @@map("invitations")
}

/// Company profile (1:1 with the tenant). Every field is optional free text supplied by the tenant; nothing is inferred or prefilled.
model OrganizationProfile {
  organization_id  String   @id @db.Uuid
  legal_name       String?
  trade_name       String?
  industry         String?
  website          String?
  description      String?
  country          String?  @db.Char(2)
  timezone         String?
  default_currency String?  @db.Char(3)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@map("organization_profiles")
}

/// Branch / site. Never deleted (future records will reference it): disabled via status. name_key = normalized name for case-insensitive uniqueness.
model Branch {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  name            String
  name_key        String
  address         String?
  city            String?
  region          String?
  country         String?      @db.Char(2)
  status          RecordStatus @default(active)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, name_key])
  @@map("branches")
}

enum CatalogItemKind {
  product
  service

  @@map("catalog_item_kind")
}

enum CatalogVersionState {
  draft
  approved
  superseded

  @@map("catalog_version_state")
}

model CatalogCategory {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  name            String
  name_key        String
  status          RecordStatus @default(active)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  versions     CatalogItemVersion[]

  @@unique([organization_id, name_key])
  @@map("catalog_categories")
}

/// Stable identity of a product/service. Content lives in immutable-once-approved versions. Status is derived:
/// archived_at set => archived; approved_version set => approved; otherwise draft.
model CatalogItem {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String          @db.Uuid
  kind             CatalogItemKind
  sku              String
  sku_key          String
  latest_version   Int             @default(1)
  approved_version Int?
  archived_at      DateTime?       @db.Timestamptz(6)
  created_by       String          @db.Uuid
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @updatedAt @db.Timestamptz(6)

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  versions     CatalogItemVersion[]
  price_entries PriceListEntry[]
  quote_lines  QuoteLine[]

  @@unique([organization_id, id])
  @@unique([organization_id, sku_key])
  @@index([organization_id, created_at(sort: Desc), id(sort: Desc)])
  @@map("catalog_items")
}

model CatalogItemVersion {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String              @db.Uuid
  item_id         String              @db.Uuid
  version         Int
  state           CatalogVersionState @default(draft)
  name            String
  description     String?
  unit            String?
  features        Json                @default("[]")
  category_id     String?             @db.Uuid
  created_by      String              @db.Uuid
  approved_by     String?             @db.Uuid
  approved_at     DateTime?           @db.Timestamptz(6)
  created_at      DateTime            @default(now()) @db.Timestamptz(6)

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  item         CatalogItem      @relation(fields: [organization_id, item_id], references: [organization_id, id], onDelete: Restrict)
  category     CatalogCategory? @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@unique([item_id, version])
  @@index([organization_id, item_id])
  @@map("catalog_item_versions")
}

enum PriceListStatus {
  draft
  approved
  archived

  @@map("price_list_status")
}

/// Immutable once approved (clone to change). Currency is fixed at creation so stored amounts can never be reinterpreted.
model PriceList {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String          @db.Uuid
  name            String
  name_key        String
  currency        String          @db.Char(3)
  status          PriceListStatus @default(draft)
  valid_from      DateTime?       @db.Date
  valid_until     DateTime?       @db.Date
  cloned_from     String?         @db.Uuid
  created_by      String          @db.Uuid
  approved_by     String?         @db.Uuid
  approved_at     DateTime?       @db.Timestamptz(6)
  archived_at     DateTime?       @db.Timestamptz(6)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  entries      PriceListEntry[]
  quotes       Quote[]

  @@unique([organization_id, id])
  @@unique([organization_id, name_key])
  @@map("price_lists")
}

/// One unit price per (list, item). Amounts are exact decimals; no tiers, taxes or discounts are modelled (none are defined by the business yet).
model PriceListEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  price_list_id   String   @db.Uuid
  item_id         String   @db.Uuid
  unit_price      Decimal  @db.Decimal(18, 4)
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  price_list   PriceList    @relation(fields: [organization_id, price_list_id], references: [organization_id, id], onDelete: Restrict)
  item         CatalogItem  @relation(fields: [organization_id, item_id], references: [organization_id, id], onDelete: Restrict)

  @@unique([price_list_id, item_id])
  @@index([organization_id, item_id])
  @@map("price_list_entries")
}

/// Append-only record of every CSV import run (dry run or apply). Stores counts, a capped error list and the SHA-256 of the file, never the file.
model ImportJob {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  kind            String
  mode            String
  status          String
  file_hash       String
  total_rows      Int
  created_count   Int
  updated_count   Int
  unchanged_count Int
  error_count     Int
  errors          Json     @default("[]")
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@index([organization_id, created_at(sort: Desc)])
  @@map("import_jobs")
}

enum ProspectStatus {
  candidate
  qualified
  disqualified

  @@map("prospect_status")
}

/// A company that MIGHT be worth contacting. Never a permission to contact. dedupe_key = domain_key, or name_key|country when no domain.
model Prospect {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String         @db.Uuid
  name            String
  name_key        String
  domain_key      String?
  dedupe_key      String
  website         String?
  country         String?        @db.Char(2)
  region          String?
  city            String?
  industry        String?
  notes           String?
  status          ProspectStatus @default(candidate)
  status_reason   String?
  created_by      String         @db.Uuid
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @updatedAt @db.Timestamptz(6)

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  sources      ProspectSource[]
  attributes   ProspectAttribute[]
  score_results ScoreResult[]
  leads        Lead[]
  assessments  IntentAssessment[]
  opportunities Opportunity[]
  contacts      Contact[]

  @@unique([organization_id, id])
  @@unique([organization_id, dedupe_key])
  @@index([organization_id, status])
  @@map("prospects")
}

/// Provenance (append-only): where and when a prospect record came from.
model ProspectSource {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  prospect_id     String   @db.Uuid
  source_type     String
  source_ref      String?
  created_by      String   @db.Uuid
  collected_at    DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  prospect     Prospect     @relation(fields: [organization_id, prospect_id], references: [organization_id, id], onDelete: Restrict)

  @@index([organization_id, prospect_id])
  @@map("prospect_sources")
}

/// Do-not-contact list. A matching prospect can never be qualified; downstream modules must consult it before any outreach.
model Suppression {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  kind            String
  value_key       String
  reason          String
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, kind, value_key])
  @@map("suppressions")
}

/// Enrichment value with provenance. Append-only apart from the human decision (verify/reject). Only VERIFIED values are scored.
model ProspectAttribute {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  prospect_id     String    @db.Uuid
  key             String
  value           String
  value_key       String
  confidence      String
  source          String
  status          String    @default("unverified")
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  decided_by      String?   @db.Uuid
  decided_at      DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  prospect     Prospect     @relation(fields: [organization_id, prospect_id], references: [organization_id, id], onDelete: Restrict)

  @@unique([prospect_id, key, value_key])
  @@index([organization_id, prospect_id])
  @@map("prospect_attributes")
}

/// Rule-based scoring model, versioned like the catalog: one draft, approved versions are immutable.
model ScoringModelVersion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  version         Int
  state           String    @default("draft")
  rules           Json
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  approved_by     String?   @db.Uuid
  approved_at     DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  results      ScoreResult[]

  @@unique([organization_id, version])
  @@map("scoring_model_versions")
}

/// Append-only, explainable score: the breakdown names every rule, whether it matched and the evidence used.
model ScoreResult {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String   @db.Uuid
  prospect_id      String   @db.Uuid
  model_version_id String   @db.Uuid
  total            Int
  breakdown        Json
  computed_by      String   @db.Uuid
  computed_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  prospect     Prospect            @relation(fields: [organization_id, prospect_id], references: [organization_id, id], onDelete: Restrict)
  model        ScoringModelVersion @relation(fields: [model_version_id], references: [id], onDelete: Restrict)

  @@index([organization_id, prospect_id, computed_at(sort: Desc)])
  @@map("score_results")
}

/// Explicit threshold for rule-created leads. There is no default: until an org_admin sets it, no lead can be created by rule.
model LeadSettings {
  organization_id String   @id @db.Uuid
  min_score       Int
  updated_by      String   @db.Uuid
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@map("lead_settings")
}

/// A lead exists only because a rule matched (score >= threshold) or a reply was classified as positive intent; a human reviews it.
/// open_key = prospect id while the lead is pending/accepted (NULL when rejected) => at most one open lead per prospect (idempotent creation).
model Lead {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String    @db.Uuid
  prospect_id     String    @db.Uuid
  origin          String
  state           String    @default("pending_review")
  open_key        String?
  score_result_id String?   @db.Uuid
  assessment_id   String?   @db.Uuid
  min_score       Int?
  review_note     String?
  reviewed_by     String?   @db.Uuid
  reviewed_at     DateTime? @db.Timestamptz(6)
  created_by      String    @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  prospect     Prospect     @relation(fields: [organization_id, prospect_id], references: [organization_id, id], onDelete: Restrict)

  opportunity  Opportunity?

  @@unique([organization_id, id])
  @@unique([organization_id, open_key])
  @@index([organization_id, state])
  @@map("leads")
}

/// Rule-based classification of a pasted reply (no channel integration yet). Explainable: stores the matched phrases and classifier version.
model IntentAssessment {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String   @db.Uuid
  prospect_id        String   @db.Uuid
  excerpt            String
  text_hash          String
  classifier_version String
  class              String
  matched            Json
  ambiguous          Boolean
  created_by         String   @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  prospect     Prospect     @relation(fields: [organization_id, prospect_id], references: [organization_id, id], onDelete: Restrict)

  @@index([organization_id, prospect_id, created_at(sort: Desc)])
  @@map("intent_assessments")
}

/// Routing configuration. No row = manual assignment and no SLA (nothing is assumed).
model RoutingSettings {
  organization_id           String   @id @db.Uuid
  strategy                  String
  first_response_sla_minutes Int?
  updated_by                String   @db.Uuid
  updated_at                DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@map("routing_settings")
}

/// Members who may receive opportunities, with a capacity. Used by the reproducible round-robin.
model SellerPoolMember {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String    @db.Uuid
  user_id          String    @db.Uuid
  active           Boolean   @default(true)
  max_open         Int
  last_assigned_at DateTime? @db.Timestamptz(6)
  created_by       String    @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, user_id])
  @@map("seller_pool")
}

/// A sales opportunity born from exactly one ACCEPTED lead. Sellers see only the ones assigned to them (enforced by RLS).
model Opportunity {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String    @db.Uuid
  lead_id                String    @db.Uuid
  prospect_id            String    @db.Uuid
  title                  String
  stage                  String    @default("new")
  owner_user_id          String?   @db.Uuid
  assigned_at            DateTime? @db.Timestamptz(6)
  expected_value         Decimal?  @db.Decimal(18, 4)
  currency               String?   @db.Char(3)
  loss_reason            String?
  first_response_due_at  DateTime? @db.Timestamptz(6)
  first_contacted_at     DateTime? @db.Timestamptz(6)
  closed_at              DateTime? @db.Timestamptz(6)
  created_by             String    @db.Uuid
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  lead         Lead         @relation(fields: [organization_id, lead_id], references: [organization_id, id], onDelete: Restrict)
  prospect     Prospect     @relation(fields: [organization_id, prospect_id], references: [organization_id, id], onDelete: Restrict)
  history      OpportunityStageHistory[]
  notes        OpportunityNote[]
  tasks        OpportunityTask[]
  assignments  OpportunityAssignment[]
  quotes       Quote[]

  @@unique([organization_id, id])
  @@unique([organization_id, lead_id])
  @@index([organization_id, stage])
  @@index([organization_id, owner_user_id])
  @@map("opportunities")
}

/// Written by a trigger on every stage change, so the history cannot be skipped or edited.
model OpportunityStageHistory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  opportunity_id  String   @db.Uuid
  from_stage      String?
  to_stage        String
  changed_by      String?  @db.Uuid
  note            String?
  changed_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  opportunity  Opportunity  @relation(fields: [organization_id, opportunity_id], references: [organization_id, id], onDelete: Restrict)

  @@index([organization_id, opportunity_id, changed_at])
  @@map("opportunity_stage_history")
}

model OpportunityNote {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  opportunity_id  String   @db.Uuid
  kind            String
  body            String
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  opportunity  Opportunity  @relation(fields: [organization_id, opportunity_id], references: [organization_id, id], onDelete: Restrict)

  @@index([organization_id, opportunity_id, created_at])
  @@map("opportunity_notes")
}

/// Follow-up task on an opportunity. Visible exactly like the opportunity (sellers only see their own); closed with done/cancelled, never edited or deleted.
model OpportunityTask {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String    @db.Uuid
  opportunity_id   String    @db.Uuid
  title            String
  due_at           DateTime  @db.Timestamptz(6)
  state            String    @default("open")
  assignee_user_id String    @db.Uuid
  created_by       String    @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  completed_by     String?   @db.Uuid
  completed_at     DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  opportunity  Opportunity  @relation(fields: [organization_id, opportunity_id], references: [organization_id, id], onDelete: Restrict)

  @@index([organization_id, state, due_at])
  @@index([organization_id, assignee_user_id, state])
  @@index([organization_id, opportunity_id])
  @@map("opportunity_tasks")
}

/// Why an opportunity went to someone (or to the queue): strategy plus the candidate snapshot, so the decision can be reproduced.
model OpportunityAssignment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  opportunity_id  String   @db.Uuid
  assigned_to     String?  @db.Uuid
  assigned_by     String   @db.Uuid
  strategy        String
  candidates      Json
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  opportunity  Opportunity  @relation(fields: [organization_id, opportunity_id], references: [organization_id, id], onDelete: Restrict)

  @@index([organization_id, opportunity_id, created_at])
  @@map("opportunity_assignments")
}

/// Discounts above this percentage need an org_admin approval before a quote can be sent. Default 0 = every discount needs approval (nothing is assumed).
model QuoteSettings {
  organization_id      String   @id @db.Uuid
  max_discount_percent Decimal  @default(0) @db.Decimal(5, 2)
  updated_by           String   @db.Uuid
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@map("quote_settings")
}

model QuoteCounter {
  organization_id String @id @db.Uuid
  last_number     Int

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@map("quote_counters")
}

/// Draft is editable; once sent the lines, prices and totals are a frozen snapshot (never recalculated).
model Quote {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String    @db.Uuid
  opportunity_id       String    @db.Uuid
  number               Int
  status               String    @default("draft")
  price_list_id        String    @db.Uuid
  currency             String    @db.Char(3)
  valid_until          DateTime? @db.Date
  tax_rate             Decimal?  @db.Decimal(7, 4)
  notes                String?
  subtotal             Decimal   @default(0) @db.Decimal(18, 4)
  discount_total       Decimal   @default(0) @db.Decimal(18, 4)
  tax_total            Decimal   @default(0) @db.Decimal(18, 4)
  total                Decimal   @default(0) @db.Decimal(18, 4)
  discount_approved_by String?   @db.Uuid
  discount_approved_at DateTime? @db.Timestamptz(6)
  lines_hash           String?
  sent_by              String?   @db.Uuid
  sent_at              DateTime? @db.Timestamptz(6)
  decided_by           String?   @db.Uuid
  decided_at           DateTime? @db.Timestamptz(6)
  decision_note        String?
  created_by           String    @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  opportunity  Opportunity  @relation(fields: [organization_id, opportunity_id], references: [organization_id, id], onDelete: Restrict)
  price_list   PriceList    @relation(fields: [organization_id, price_list_id], references: [organization_id, id], onDelete: Restrict)
  lines        QuoteLine[]
  sale         Sale?

  @@unique([organization_id, id])
  @@unique([organization_id, number])
  @@index([organization_id, opportunity_id])
  @@map("quotes")
}

/// Every line is a snapshot built from APPROVED evidence: item version + price entry refs, and the amounts computed with exact decimals.
model QuoteLine {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  quote_id        String   @db.Uuid
  position        Int
  item_id         String   @db.Uuid
  sku             String
  item_name       String
  item_version    Int
  unit            String?
  item_ref        String
  price_ref       String
  quantity        Decimal  @db.Decimal(18, 4)
  unit_price      Decimal  @db.Decimal(18, 4)
  discount_percent Decimal @default(0) @db.Decimal(5, 2)
  gross           Decimal  @db.Decimal(18, 4)
  discount_amount Decimal  @db.Decimal(18, 4)
  line_total      Decimal  @db.Decimal(18, 4)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  quote        Quote        @relation(fields: [organization_id, quote_id], references: [organization_id, id], onDelete: Restrict)
  item         CatalogItem  @relation(fields: [organization_id, item_id], references: [organization_id, id], onDelete: Restrict)

  @@unique([quote_id, position])
  @@unique([quote_id, item_id])
  @@map("quote_lines")
}

/// Immutable record of an accepted quote: links lead -> opportunity -> quote -> sale.
model Sale {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  quote_id        String   @db.Uuid
  opportunity_id  String   @db.Uuid
  lead_id         String   @db.Uuid
  prospect_id     String   @db.Uuid
  total           Decimal  @db.Decimal(18, 4)
  currency        String   @db.Char(3)
  closed_by       String   @db.Uuid
  closed_at       DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  quote        Quote        @relation(fields: [organization_id, quote_id], references: [organization_id, id], onDelete: Restrict)

  @@unique([organization_id, quote_id])
  @@map("sales")
}

/// Monthly AI spend limit per tenant, in micro-units (1 000 000 = 1.00). No row means AI is blocked for the tenant (deny by default).
model AiBudget {
  organization_id      String   @id @db.Uuid
  monthly_limit_micros BigInt
  updated_by           String   @db.Uuid
  updated_at           DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@map("ai_budgets")
}

/// One AI gateway call: what was asked (capability + versioned prompt), what it cost, what came back and why it did or did not need review.
/// Append-only (no UPDATE/DELETE grants). The raw untrusted text is never stored, only the validated output.
model AiRun {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  user_id         String   @db.Uuid
  capability      String
  prompt_key      String
  prompt_version  Int
  provider        String
  model           String
  status          String
  input_tokens    Int      @default(0)
  output_tokens   Int      @default(0)
  cost_micros     BigInt   @default(0)
  latency_ms      Int      @default(0)
  evidence_refs   String[]
  flags           String[]
  needs_review    Boolean  @default(false)
  confidence      Decimal? @db.Decimal(4, 3)
  output          Json?
  request_id      String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@index([organization_id, created_at])
  @@index([organization_id, needs_review, created_at])
  @@map("ai_runs")
}

/// A person's contact point at a prospect. Never created by inference: every row carries its source. Contacting requires a recorded, live consent.
model Contact {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  prospect_id     String   @db.Uuid
  channel         String   @default("email")
  address         String
  address_key     String
  display_name    String?
  source          String
  status          String   @default("active")
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization    @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  prospect     Prospect        @relation(fields: [organization_id, prospect_id], references: [organization_id, id], onDelete: Restrict)
  consents     ConsentEvent[]
  attempts     SendAttempt[]

  @@unique([organization_id, id])
  @@unique([organization_id, channel, address_key])
  @@index([organization_id, prospect_id])
  @@map("contacts")
}

/// Append-only consent ledger. The current consent is the latest event. recorded_by is NULL only for a self-service unsubscribe.
model ConsentEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  contact_id      String   @db.Uuid
  event           String
  purpose         String   @default("commercial_outreach")
  evidence        String
  occurred_at     DateTime @db.Timestamptz(6)
  recorded_by     String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  contact      Contact      @relation(fields: [organization_id, contact_id], references: [organization_id, id], onDelete: Restrict)

  @@index([organization_id, contact_id, occurred_at])
  @@map("consent_events")
}

/// One email, written once, approved by a human before it can be launched. The body must carry the unsubscribe placeholder.
model Campaign {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String    @db.Uuid
  name             String
  subject          String
  body             String
  state            String    @default("draft")
  min_days_between Int       @default(7)
  created_by       String    @db.Uuid
  approved_by      String?   @db.Uuid
  approved_at      DateTime? @db.Timestamptz(6)
  launched_at      DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)

  organization Organization  @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  attempts     SendAttempt[]

  @@unique([organization_id, id])
  @@index([organization_id, state])
  @@map("campaigns")
}

/// One attempt per (campaign, contact); the unique pair makes launching and dispatching idempotent. Eligibility is re-checked at send time.
model SendAttempt {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String    @db.Uuid
  campaign_id         String    @db.Uuid
  contact_id          String    @db.Uuid
  state               String    @default("queued")
  skip_reason         String?
  provider            String?
  provider_message_id String?
  attempted_at        DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  campaign     Campaign     @relation(fields: [organization_id, campaign_id], references: [organization_id, id], onDelete: Restrict)
  contact      Contact      @relation(fields: [organization_id, contact_id], references: [organization_id, id], onDelete: Restrict)

  @@unique([campaign_id, contact_id])
  @@index([organization_id, campaign_id, state])
  @@index([organization_id, contact_id, state])
  @@map("send_attempts")
}
