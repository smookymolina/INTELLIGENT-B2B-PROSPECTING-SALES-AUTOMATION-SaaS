generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  org_admin
  campaign_manager
  sales_manager
  seller
  analyst
  viewer

  @@map("membership_role")
}

enum RecordStatus {
  active
  disabled

  @@map("record_status")
}

/// Tenant root. RLS: id = app.organization_id.
model Organization {
  id         String       @id @default(uuid(7)) @db.Uuid
  name       String
  slug       String       @unique
  status     RecordStatus @default(active)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @updatedAt @db.Timestamptz(6)

  memberships Membership[]
  audit_events AuditEvent[]
  sessions    Session[]
  invitations Invitation[]
  profile     OrganizationProfile?
  branches    Branch[]
  catalog_categories CatalogCategory[]
  catalog_items      CatalogItem[]
  catalog_versions   CatalogItemVersion[]
  price_lists        PriceList[]
  price_entries      PriceListEntry[]
  import_jobs        ImportJob[]

  @@map("organizations")
}

/// Global identity (a person may belong to several organizations). Access is mediated by RLS + SECURITY DEFINER auth functions.
model User {
  id            String       @id @default(uuid(7)) @db.Uuid
  email         String       @unique
  password_hash String
  display_name  String
  status        RecordStatus @default(active)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)

  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Membership {
  id              String         @id @default(uuid(7)) @db.Uuid
  organization_id String         @db.Uuid
  user_id         String         @db.Uuid
  role            MembershipRole
  status          RecordStatus   @default(active)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, user_id])
  @@index([user_id])
  @@map("memberships")
}

/// Opaque bearer sessions; only the SHA-256 of the token is stored.
model Session {
  id              String    @id @default(uuid(7)) @db.Uuid
  organization_id String    @db.Uuid
  user_id         String    @db.Uuid
  token_hash      String    @unique
  expires_at      DateTime  @db.Timestamptz(6)
  revoked_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([organization_id, user_id])
  @@map("sessions")
}

/// Append-only (RLS has no UPDATE/DELETE policy; trigger blocks both).
model AuditEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  organization_id String   @db.Uuid
  actor_user_id   String?  @db.Uuid
  action          String
  resource_type   String
  resource_id     String?
  metadata        Json     @default("{}")
  request_id      String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@index([organization_id, created_at(sort: Desc)])
  @@map("audit_events")
}

/// Pre-tenant login throttle state. Only keyed HMACs, never raw IP/email. No grants to app_runtime: access via auth_login_* functions.
model LoginAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ip_hash      String
  account_hash String
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([ip_hash, created_at])
  @@index([account_hash, created_at])
  @@index([created_at])
  @@map("login_attempts")
}

/// Idempotent command results. Keys are keyed HMACs; the stored response (may contain a session token) is AES-256-GCM ciphertext.
/// No grants to app_runtime: access via idem_* functions.
model IdempotencyKey {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope               String
  key_hash            String
  request_hash        String
  response_ciphertext String?
  completed_at        DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([scope, key_hash])
  @@index([created_at])
  @@map("idempotency_keys")
}

/// Pending membership offers. Creating one never creates a membership; acceptance (invitation_accept) does, atomically.
/// Only the SHA-256 of the token is stored. RLS: tenant-scoped, org_admin writes.
model Invitation {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String         @db.Uuid
  email           String
  role            MembershipRole
  token_hash      String         @unique
  invited_by      String         @db.Uuid
  expires_at      DateTime       @db.Timestamptz(6)
  accepted_at     DateTime?      @db.Timestamptz(6)
  accepted_by     String?        @db.Uuid
  revoked_at      DateTime?      @db.Timestamptz(6)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@index([organization_id, created_at(sort: Desc)])
  @@index([organization_id, email])
  @@map("invitations")
}

/// Company profile (1:1 with the tenant). Every field is optional free text supplied by the tenant; nothing is inferred or prefilled.
model OrganizationProfile {
  organization_id  String   @id @db.Uuid
  legal_name       String?
  trade_name       String?
  industry         String?
  website          String?
  description      String?
  country          String?  @db.Char(2)
  timezone         String?
  default_currency String?  @db.Char(3)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@map("organization_profiles")
}

/// Branch / site. Never deleted (future records will reference it): disabled via status. name_key = normalized name for case-insensitive uniqueness.
model Branch {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  name            String
  name_key        String
  address         String?
  city            String?
  region          String?
  country         String?      @db.Char(2)
  status          RecordStatus @default(active)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, name_key])
  @@map("branches")
}

enum CatalogItemKind {
  product
  service

  @@map("catalog_item_kind")
}

enum CatalogVersionState {
  draft
  approved
  superseded

  @@map("catalog_version_state")
}

model CatalogCategory {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String       @db.Uuid
  name            String
  name_key        String
  status          RecordStatus @default(active)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  versions     CatalogItemVersion[]

  @@unique([organization_id, name_key])
  @@map("catalog_categories")
}

/// Stable identity of a product/service. Content lives in immutable-once-approved versions. Status is derived:
/// archived_at set => archived; approved_version set => approved; otherwise draft.
model CatalogItem {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String          @db.Uuid
  kind             CatalogItemKind
  sku              String
  sku_key          String
  latest_version   Int             @default(1)
  approved_version Int?
  archived_at      DateTime?       @db.Timestamptz(6)
  created_by       String          @db.Uuid
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @updatedAt @db.Timestamptz(6)

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  versions     CatalogItemVersion[]
  price_entries PriceListEntry[]

  @@unique([organization_id, id])
  @@unique([organization_id, sku_key])
  @@index([organization_id, created_at(sort: Desc), id(sort: Desc)])
  @@map("catalog_items")
}

model CatalogItemVersion {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String              @db.Uuid
  item_id         String              @db.Uuid
  version         Int
  state           CatalogVersionState @default(draft)
  name            String
  description     String?
  unit            String?
  features        Json                @default("[]")
  category_id     String?             @db.Uuid
  created_by      String              @db.Uuid
  approved_by     String?             @db.Uuid
  approved_at     DateTime?           @db.Timestamptz(6)
  created_at      DateTime            @default(now()) @db.Timestamptz(6)

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  item         CatalogItem      @relation(fields: [organization_id, item_id], references: [organization_id, id], onDelete: Restrict)
  category     CatalogCategory? @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@unique([item_id, version])
  @@index([organization_id, item_id])
  @@map("catalog_item_versions")
}

enum PriceListStatus {
  draft
  approved
  archived

  @@map("price_list_status")
}

/// Immutable once approved (clone to change). Currency is fixed at creation so stored amounts can never be reinterpreted.
model PriceList {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String          @db.Uuid
  name            String
  name_key        String
  currency        String          @db.Char(3)
  status          PriceListStatus @default(draft)
  valid_from      DateTime?       @db.Date
  valid_until     DateTime?       @db.Date
  cloned_from     String?         @db.Uuid
  created_by      String          @db.Uuid
  approved_by     String?         @db.Uuid
  approved_at     DateTime?       @db.Timestamptz(6)
  archived_at     DateTime?       @db.Timestamptz(6)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)

  organization Organization     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  entries      PriceListEntry[]

  @@unique([organization_id, id])
  @@unique([organization_id, name_key])
  @@map("price_lists")
}

/// One unit price per (list, item). Amounts are exact decimals; no tiers, taxes or discounts are modelled (none are defined by the business yet).
model PriceListEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  price_list_id   String   @db.Uuid
  item_id         String   @db.Uuid
  unit_price      Decimal  @db.Decimal(18, 4)
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  price_list   PriceList    @relation(fields: [organization_id, price_list_id], references: [organization_id, id], onDelete: Restrict)
  item         CatalogItem  @relation(fields: [organization_id, item_id], references: [organization_id, id], onDelete: Restrict)

  @@unique([price_list_id, item_id])
  @@index([organization_id, item_id])
  @@map("price_list_entries")
}

/// Append-only record of every CSV import run (dry run or apply). Stores counts, a capped error list and the SHA-256 of the file, never the file.
model ImportJob {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  kind            String
  mode            String
  status          String
  file_hash       String
  total_rows      Int
  created_count   Int
  updated_count   Int
  unchanged_count Int
  error_count     Int
  errors          Json     @default("[]")
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)

  @@index([organization_id, created_at(sort: Desc)])
  @@map("import_jobs")
}
