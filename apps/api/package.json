{
  "name": "@prospecting/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node \"../../node_modules/tsx/dist/cli.mjs\" watch --env-file-if-exists=../../.env src/main.ts",
    "worker": "node \"../../node_modules/tsx/dist/cli.mjs\" --env-file-if-exists=../../.env src/worker/main.ts",
    "worker:dev": "node \"../../node_modules/tsx/dist/cli.mjs\" watch --env-file-if-exists=../../.env src/worker/main.ts",
    "build": "node \"../../node_modules/typescript/bin/tsc\" -p tsconfig.json",
    "typecheck": "node \"../../node_modules/typescript/bin/tsc\" --noEmit -p tsconfig.json",
    "lint": "node \"../../node_modules/eslint/bin/eslint.js\" src --max-warnings=0",
    "test": "node \"../../node_modules/vitest/vitest.mjs\" run --exclude \"**/*.int.spec.ts\" --exclude \"**/node_modules/**\" --exclude \"dist/**\"",
    "test:int": "node \"../../node_modules/vitest/vitest.mjs\" run int.spec --no-file-parallelism --exclude \"dist/**\" --exclude \"**/node_modules/**\"",
    "db:generate": "node \"../../node_modules/prisma/build/index.js\" generate",
    "db:migrate:deploy": "node \"../../node_modules/prisma/build/index.js\" migrate deploy",
    "db:migrate:status": "node \"../../node_modules/prisma/build/index.js\" migrate status"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prospecting/contracts": "0.1.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
